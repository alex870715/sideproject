{
  "expo": {
    "name": "Earth Online",
    "slug": "earth-online",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.earthonline.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "允許錄製語音訊息，供好友語音叫醒使用。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1220"
      },
      "package": "com.earthonline.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "scheme": "earthonline",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0b1220"
        }
      ],
      "expo-localization"
    ]
  }
}
