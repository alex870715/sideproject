# Supabase（雲端同步 player_fog）
EXPO_PUBLIC_SUPABASE_URL=https://你的專案.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=你的_anon_key

# Mapbox（地球 + 衛星 + 迷霧圖層）https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=pk.

# 探索頁「模擬打卡／示範路徑／Google·GeoJSON 匯入」僅在下列之一成立時顯示：Metro __DEV__、此處設為 1、或登入 Email 在 DEV_TESTER_EMAILS 內。正式上架請勿設 1。
# EXPO_PUBLIC_DEV_EXPLORE_TOOLS=1
# 逗號分隔、不分大小寫，例如 you@test.com,other@example.com
# EXPO_PUBLIC_DEV_TESTER_EMAILS=
