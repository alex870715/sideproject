# 複製本檔為 .env 並填入你的 OKX 「Demo Trading」API Key
# 取得方式：登入 OKX → 右上角頭像 → Demo Trading → API Management → Create API Key
# 注意：Demo 環境的 API Key 與正式環境不通用！

OKX_API_KEY=""
OKX_API_SECRET=""
OKX_PASSPHRASE=""

# true = 走 demo trading（會帶上 x-simulated-trading: 1 header）
# false = 走正式環境（請小心！）
OKX_DEMO=true

# 預設交易標的；OKX 永續合約 symbol 格式為 <BASE>-<QUOTE>-SWAP
OKX_SYMBOL=BTC-USDT-SWAP

# K 線週期：1m / 3m / 5m / 15m / 30m / 1H / 4H / 1D
# 建議 5m：edge 測試顯示 1m 的手續費拖累太重（含費期望 −0.28R），
# 拉到 5m 後幾乎收斂到打平（−0.08R、勝率 ~53%）。週期越高、單筆波動越大、手續費佔比越小。
OKX_BAR=5m

# 每次輪詢 candle 的間隔秒數（最低建議 3 秒，避免打到 rate limit）
OKX_POLL_SECONDS=5

# Cloud-only settings (set in the hosting provider, never commit real values).
# BOT_PUBLIC_ORIGIN=https://your-service.onrender.com
# BOT_ADMIN_USER=alex
# BOT_ADMIN_PASSWORD=<random password, at least 32 characters>
# BOT_DATA_DIR=/var/data
